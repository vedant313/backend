FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng tesseract-ocr-hin fonts-dejavu-core fonts-noto-core && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-ocr.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY services/pdf_ocr_service.py ./pdf_ocr_service.py
CMD ["sh", "-c", "uvicorn pdf_ocr_service:app --host 0.0.0.0 --port ${PORT:-8000}"]
